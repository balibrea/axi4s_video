#include "zynq-7000.dtsi"
#include "pl.dtsi"
#include "pcw.dtsi"
//#include "xilinx-vip.h"
/ {

    aliases {
        i2c0 = &axi_iic_0;
        serial0 = &uart1;
        serial1 = &uart0;
        serial2 = &bluetooth_uart;
        spi0 = &qspi;
    };

    /* WiFi Module:  WL_REG_ON GPIO Control */
    wlreg_on: wlreg-on {
        compatible = "regulator-fixed";
        regulator-name = "wlreg_on";
        enable-active-high;
        gpio = <&gpio0 56 0>;
        regulator-min-microvolt = <3300000>;
        regulator-max-microvolt = <3300000>;
        startup-delay-us = <100>;
    };

    // Uncomment this to use bcmdhd driver instead of brcmfmac driver:
    // bcmdhd_wlan_0: bcmdhd_wlan@0 {
    //     compatible = "android,bcmdhd_wlan";
    //     wlreg_on-supply = <&wlreg_on>;
    //     // gpios = <&gpio0 0 4>;  // OOB interrupts
    // };

    // NOTE: BT_REG_ON (EMIO[0] = gpio0 54) is driven directly by
    // the hci_bcm driver via shutdown-gpios in the &bluetooth_uart
    // node below.  Do NOT declare a btreg_on regulator on the same
    // GPIO -- it would claim the line and stop hci_bcm from
    // power-sequencing the chip.
};

/{
    usb_phy0: usb_phy@0 {
        compatible = "ulpi-phy";
        #phy-cells = <0>;
        reg = <0xe0002000 0x1000>;
        view-port = <0x0170>;
        drv-vbus;
    };
};

&usb0 {
    dr_mode = "otg";
    usb-phy = <&usb_phy0>;
} ;

/* QSPI addresses are defined with petalinux-config, but here they are overwritten so that one can program the flash internally */
&qspi {
    #address-cells = <1>;
    #size-cells = <0>;
    flash0: flash@0 {
        compatible = "micron,m25p80";
        reg = <0x0>;
        #address-cells = <1>;
        #size-cells = <1>;
        spi-max-frequency = <50000000>;
        partition@0 {
            label = "boot";
            reg = <0x00000000 0x00ff0000>;
        };
    };
};

/* SD Interface for Wi-Fi Module */
&sdhci0 {
    status = "okay";
    bus-width= <4>;
    xlnx,has-cd = <0x0>;
    xlnx,has-power = <0x0>;
    xlnx,has-wp = <0x0>;
    non-removeable;
    broken-cd;
    vmmc-supply = <&wlreg_on>;  /* Uncomment for brcmfmac */
    /* wifi-host; */ /* uncomment for bcmdhd */


        brcmf: brcmf@1 {
        status = "okay";
                reg = <1>;
                compatible = "brcm,bcm43430-fmac";
        /* interrupt-parent = <&gpio0>; */ /* For WL_HOST_WAKE OOB Interrupt */
        /* interrupts = <0 29 8>; */  /* PL-PS direct interrupt, Low Level */
        /* interrupts = <57 8>; */ /* GPIO EMIO 3, Low Level */
        /* interrupt-names = "host-wake"; */
    };
};

/* SD Interface for eMMC */
&sdhci1 {
    status = "okay";
    non-removeable;
    bus-width= <4>;
    xlnx,has-cd = <0x0>;
    xlnx,has-power = <0x0>;
    xlnx,has-wp = <0x0>;

    mmccard: mmccard@0 {
        reg = <0>;
        compatible = "mmc-card";
        broken-hpi;
    };
};

/* Console UART.  UART1 is tied to the USB serial port on the Zedboard */
&uart1 {
    status = "okay";
    current-speed = <115200>;
    port-number = <0>;
};


&bluetooth_uart {
    status = "okay";
    /*
     * Boot at 115200; hci_bcm will switch the chip to max-speed
     * AFTER firmware (BCM43430A1.hcd) is downloaded.
     */
    current-speed = <115200>;
    uart-has-rtscts;
    port-number = <2>;

    bluetooth {
        /*
         * The Murata 1DX uses a Cypress/Infineon CYW43430A1.
         * Upstream hci_bcm matches "brcm,bcm43438-bt" for this die.
         * Keep "brcm,bcm43430-bt" as fallback in case the Xilinx
         * kernel carries a vendor patch for that string.
         */
        compatible = "brcm,bcm43438-bt", "brcm,bcm43430-bt";

        /* BT_REG_ON -- active high, driven by hci_bcm */
        shutdown-gpios = <&gpio0 54 0>;

        /* Operating speed after firmware download */
        max-speed = <3000000>;
    };
};


/* AXI IIC.  Interfaces with the ST LIS2DS12 accelerometer */
&axi_iic_0 {
    status = "okay";

    /* MiniZed doesn't support interrupts from the accelerometer */
        accel0: lis2ds12@1d {
            compatible = "st,lis2ds12";
            reg = <0x1d>;
        };

};


&flash0 {
    compatible = "micron,n25q128", "jedec,spi-nor";
};


&amba {
        /delete-node/ ptm@f889d000 ;

        funnel@f8804000 {
                in-ports {
                      /delete-node/ port@1 ;
                };
        };
};

/*
 * Hardware path:
 *
 *   m_axis_0  --AXI4-Stream-->  axi_vdma_0 S2MM  --M_AXI_S2MM-->
 *   axi_mem_intercon  -->  PS S_AXI_HP0  -->  DDR
 *
 * PLACEMENT: this block references &axi_vdma_0, which is defined by the
 * autogenerated pl.dtsi.  It therefore has to sit *after* the
 * #include "pl.dtsi" at the top of this file -- keep it last.  pl.dtsi is
 * regenerated from the XSA on every hardware build; this file is not, so the
 * node survives a rebuild as long as the flow's system_bsp_dtsi points here.
 *
 * WHY A PLAIN NODE AND NOT AN "xlnx,video" VIPP GRAPH:
 * m_axis_0 has no AXI-Lite interface.  It free-runs from reset, emitting
 * tuser as SOF and tlast as EOL, so there is no subdev to negotiate a format
 * with and xilinx-vipp would never finish building its media graph.  The node
 * below is bound by the sw/modules/vpatt-v4l2 driver, which claims the VDMA
 * S2MM channel through dmaengine and exposes a fixed-format /dev/videoN.
 *
 * DMA CHANNEL INDEX -- must be 1, not 0.  The index is NOT the position of
 * the dma-channel child node; xilinx_dma.c assigns it by direction:
 *
 *     xdev->s2mm_chan_id = xdev->dma_config->max_channels / 2;   -- = 1
 *     chan->id = xdev->s2mm_chan_id++;                           -- S2MM
 *
 * VDMA has max_channels = 2, so MM2S is always chan[0] and S2MM is always
 * chan[1] -- even here, where MM2S is excluded (C_INCLUDE_MM2S = 0) and
 * chan[0] therefore stays NULL.  With <&axi_vdma_0 0>, of_dma_xilinx_xlate()
 * hits that NULL and returns -ENODEV from dma_request_chan().
 *
 * GEOMETRY: must track the m_axis_0 generics (H_RES, V_RES, TDATA_WIDTH).
 * The core drives tdata = {8'h00, red[7:0], green[7:0], blue[7:0]}, which
 * reaches memory little-endian as B, G, R, X -- V4L2_PIX_FMT_XBGR32 ('XR24'),
 * 4 bytes/pixel, bytesperline = 640 * 4 = 2560, sizeimage = 1228800.
 * Change these and the RTL generics together, or the VDMA will be programmed
 * for a frame size the fabric does not produce.
 *
 * Kept at the root rather than inside &amba_pl so it resolves whether pl.dtsi
 * was generated in its static (amba_pl node) or overlay (/plugin/) form.
 */

/*
 * Dedicated CMA pool for the capture buffers.
 *
 * The global 16 MiB pool fragments in normal use and cannot be relied on:
 * a 640x480x4 frame is 1228800 bytes = 300 pages, and dma_alloc_contiguous()
 * aligns it to min(get_order(size), CONFIG_CMA_ALIGNMENT) = 8, i.e. 256 pages
 * (1 MiB).  Once the global pool is chopped up, the largest free run can still
 * be >300 pages yet contain no 1 MiB-aligned 300-page window, and the alloc
 * fails with -EBUSY even though several MiB are nominally free.
 *
 * A private region sidesteps that entirely.  "reusable" lets the kernel hand
 * these pages to movable allocations while we are idle, so nothing is wasted
 * when the camera is closed.  Do NOT add "no-map" (rmem_cma_setup() rejects
 * it) and do NOT add "linux,cma-default" (that would hijack the system-wide
 * pool).  base and size must be CMA_MIN_ALIGNMENT_BYTES aligned, hence the
 * explicit 1 MiB alignment; no "reg" is given so the kernel places it.
 *
 * 8 MiB holds six 1.2 MiB buffers; the driver asks for three.
 */
/ {
    reserved-memory {
        #address-cells = <1>;
        #size-cells = <1>;
        ranges;

        vpatt_cma: vpatt-buffers {
            compatible = "shared-dma-pool";
            reusable;
            size = <0x800000>;
            alignment = <0x100000>;
        };
    };

    video_cap: video-capture {
        compatible = "minized,vpatt-v4l2-1.0";

        dmas = <&axi_vdma_0 1>;
        dma-names = "s2mm";

        memory-region = <&vpatt_cma>;

        minized,width  = <640>;
        minized,height = <480>;
    };
};
